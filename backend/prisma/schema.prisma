generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum RoleNom {
  ROLE_USER
  ROLE_ADMIN
}

enum StatutUtilisateur {
  ACTIF
  SUSPENDU
  BANNI
  INACTIF
}

enum TypeJeton {
  VERIF_EMAIL
  RESET_MDP
}

enum StatutCagnotte {
  ACTIVE
  TERMINEE
  SUSPENDUE
  ANNULEE
  // En attente de publication (identité en cours de vérification ou règle de risque) et refusée
  // par la modération : invisibles du public, comme une cagnotte privée.
  EN_VERIFICATION
  REFUSEE
}

// Fournisseur de paiement Mobile Money (variable PAIEMENT_FOURNISSEUR).
enum FournisseurPaiement {
  NOTCHPAY
  AANGARAA
}

enum MethodePaiement {
  MTN_MOBILE_MONEY
  ORANGE_MONEY
}

enum StatutPaiement {
  EN_ATTENTE
  VALIDE
  ECHOUE
  REMBOURSE
}

// APPROUVE : versement Notch Pay lancé, en attente de son statut final.
// ECHOUE : versement échoué ; le retrait peut être relancé ou rejeté, et n'est plus engagé.
enum StatutRetrait {
  EN_ATTENTE
  APPROUVE
  REJETE
  TRAITE
  ECHOUE
}

enum TypeTransaction {
  DON
  RETRAIT
  REMBOURSEMENT
}

enum StatutTransaction {
  EN_ATTENTE
  SUCCES
  ECHEC
}

// Langue de l'interface et des emails.
enum Langue {
  fr
  en
}

enum TypeNotification {
  DON
  RETRAIT
  COMMENTAIRE
  SYSTEME
  VERIFICATION
}

enum StatutLecture {
  NON_LUE
  LUE
}

// ============================================================
// MODELS
// ============================================================

model Role {
  id_role   Int        @id @default(autoincrement())
  nom       RoleNom    @unique
  posseders Posseder[]

  @@map("slf_role")
}

model Utilisateur {
  id_utilisateur      Int               @id @default(autoincrement())
  nom                 String            @db.VarChar(100)
  prenom              String            @db.VarChar(100)
  email               String            @unique @db.VarChar(255)
  // Vide pour un compte créé avec Google (connexion par email et mot de passe impossible).
  mot_de_passe        String?           @db.VarChar(255)
  // Identifiant Google (« sub ») du compte lié, pour la connexion avec Google.
  google_id           String?           @unique @db.VarChar(255)
  telephone           String?           @unique @db.VarChar(20)
  photo_profil        String?           @db.VarChar(255)
  date_inscription    DateTime          @default(now())
  est_verifie         Boolean           @default(false)
  statut              StatutUtilisateur @default(ACTIF)
  date_fin_suspension DateTime?
  // Dernier changement de mot de passe : les jetons JWT émis avant cette date sont refusés.
  date_changement_mdp DateTime?
  // Langue choisie dans l'interface : utilisée pour les emails envoyés à l'utilisateur.
  langue_preferee     Langue            @default(fr)

  posseders     Posseder[]
  jetons        Jeton[]
  cagnottes     Cagnotte[]
  paiements     Paiement[]
  dons          Don[]
  commentaires  Commentaire[]
  retraits      Retrait[]
  notifications Recevoir[]

  verifications_identite VerificationIdentite[]        @relation("VerificationsUtilisateur")
  decisions_identite     VerificationIdentite[]        @relation("DecisionsAdmin")
  journal_identite       JournalVerificationIdentite[]
  signalements           Signalement[]                 @relation("SignalementsAuteur")
  signalements_classes   Signalement[]                 @relation("SignalementsAdmin")

  @@index([email])
  @@index([statut])
  @@map("slf_utilisateur")
}

model Posseder {
  id_utilisateur Int
  id_role        Int
  utilisateur    Utilisateur @relation(fields: [id_utilisateur], references: [id_utilisateur], onDelete: Cascade)
  role           Role        @relation(fields: [id_role], references: [id_role], onDelete: Cascade)

  @@id([id_utilisateur, id_role])
  @@map("slf_posseder")
}

model Jeton {
  id_jeton        Int         @id @default(autoincrement())
  id_utilisateur  Int
  utilisateur     Utilisateur @relation(fields: [id_utilisateur], references: [id_utilisateur], onDelete: Cascade)
  code            String      @db.VarChar(255) // hash sha256 du code, jamais le code en clair
  type            TypeJeton
  date_creation   DateTime    @default(now())
  date_expiration DateTime
  est_utilise     Boolean     @default(false)
  tentatives      Int         @default(0)

  @@index([id_utilisateur, type, est_utilise])
  @@map("slf_jeton")
}

model Categorie {
  id_categorie Int        @id @default(autoincrement())
  nom          String     @unique @db.VarChar(100)
  description  String?
  icone        String?    @db.VarChar(255)
  couleur      String?    @db.VarChar(50)
  cagnottes    Cagnotte[]

  @@map("slf_categorie")
}

model Cagnotte {
  id_cagnotte          Int            @id @default(autoincrement())
  titre                String         @db.VarChar(255)
  slug                 String         @unique @db.VarChar(255)
  description          String?
  objectif             Decimal        @db.Decimal(15, 2)
  montant_collecte     Decimal        @default(0.00) @db.Decimal(15, 2)
  date_debut           DateTime       @db.Date
  date_fin             DateTime       @db.Date
  statut               StatutCagnotte @default(ACTIVE)
  est_publique         Boolean        @default(true)
  date_creation        DateTime       @default(now())
  date_modification    DateTime?      @updatedAt
  devise               String         @default("XAF") @db.VarChar(10)
  // Photo de couverture en WebP : 1200 px de large (page de la cagnotte) et 400 px (cartes, miniatures).
  image                String?        @db.VarChar(255)
  image_miniature      String?        @db.VarChar(255)
  // Pourquoi la cagnotte est EN_VERIFICATION (codes : IDENTITE_EN_ATTENTE, OBJECTIF_ELEVE,
  // ANTECEDENT_ORGANISATEUR, REVISION_APRES_REFUS). Vide pour les autres statuts.
  raisons_verification String[]
  // Motif communiqué à l'organisateur quand la modération refuse la cagnotte.
  motif_refus          String?

  id_utilisateur Int
  utilisateur    Utilisateur @relation(fields: [id_utilisateur], references: [id_utilisateur], onDelete: Restrict)

  id_categorie Int?
  categorie    Categorie? @relation(fields: [id_categorie], references: [id_categorie], onDelete: SetNull)

  dons          Don[]
  commentaires  Commentaire[]
  retraits      Retrait[]
  notifications Notification[]
  actualites    Actualite[]
  signalements  Signalement[]
  commissions   Commission[]

  @@index([id_utilisateur])
  @@index([statut])
  @@index([id_categorie])
  @@index([date_fin])
  @@map("slf_cagnotte")
}

model Paiement {
  id_paiement           Int                  @id @default(autoincrement())
  montant               Decimal              @db.Decimal(15, 2)
  devise                String               @default("XAF") @db.VarChar(10)
  methode_paiement      MethodePaiement
  // Notre référence (« SOLIFUND-DON-<id_don> »), envoyée au fournisseur à la création du paiement.
  reference             String               @unique @db.VarChar(100)
  // Fournisseur qui a traité le paiement (vide pour les paiements antérieurs aux fournisseurs).
  fournisseur           FournisseurPaiement?
  // Référence du paiement chez le fournisseur, qui sert à le consulter (et l'annuler) :
  // Notch Pay : « trx.… » ; AangaraaPay : le payToken.
  reference_fournisseur String?              @db.VarChar(255)
  // Canal Notch Pay (« cm.mtn », « cm.orange ») ou opérateur AangaraaPay (« MTN_Cameroon »).
  canal                 String?              @db.VarChar(50)
  // Dernier statut renvoyé par le fournisseur (« failed », « SUCCESSFUL »...) et raison donnée par
  // l'opérateur (details.reason chez AangaraaPay).
  statut_operateur      String?              @db.VarChar(50)
  raison_operateur      String?
  // Raison de l'échec retenue par SoliFund, quand le paiement a échoué.
  code_erreur           String?              @db.VarChar(100)
  message_erreur        String?
  statut                StatutPaiement       @default(EN_ATTENTE)
  date_creation         DateTime             @default(now())
  date_maj              DateTime?            @updatedAt
  numero_payeur         String?              @db.VarChar(20)

  id_utilisateur Int
  utilisateur    Utilisateur @relation(fields: [id_utilisateur], references: [id_utilisateur], onDelete: Restrict)

  don          Don?
  transactions Transaction[]

  @@index([statut])
  @@index([id_utilisateur])
  @@index([reference_fournisseur])
  @@map("slf_paiement")
}

model Don {
  id_don        Int            @id @default(autoincrement())
  // Montant du don (ajouté à la cagnotte), frais de transaction Mobile Money payés par le donateur
  // (src/config/frais-transaction.ts), et total payé : c'est le total qui est demandé au
  // fournisseur (Paiement.montant) et vérifié à la validation.
  montant_don   Decimal        @db.Decimal(15, 2)
  montant_frais Decimal        @default(0) @db.Decimal(15, 2)
  montant_total Decimal        @db.Decimal(15, 2)
  message       String?
  est_anonyme   Boolean        @default(false)
  date_creation DateTime       @default(now())
  statut        StatutPaiement @default(EN_ATTENTE)

  id_cagnotte Int
  cagnotte    Cagnotte @relation(fields: [id_cagnotte], references: [id_cagnotte], onDelete: Restrict)

  id_utilisateur Int?
  utilisateur    Utilisateur? @relation(fields: [id_utilisateur], references: [id_utilisateur], onDelete: SetNull)

  id_paiement Int      @unique
  paiement    Paiement @relation(fields: [id_paiement], references: [id_paiement], onDelete: Restrict)

  @@index([id_cagnotte])
  @@index([id_utilisateur])
  @@map("slf_don")
}

model Commentaire {
  id_commentaire Int      @id @default(autoincrement())
  date_creation  DateTime @default(now())
  description    String

  id_utilisateur Int
  utilisateur    Utilisateur @relation(fields: [id_utilisateur], references: [id_utilisateur], onDelete: Cascade)

  id_cagnotte Int
  cagnotte    Cagnotte @relation(fields: [id_cagnotte], references: [id_cagnotte], onDelete: Cascade)

  @@index([id_cagnotte])
  @@index([id_utilisateur])
  @@map("slf_commentaire")
}

model Retrait {
  id_retrait            Int                  @id @default(autoincrement())
  // Montant demandé par l'organisateur (déduit du disponible de la cagnotte).
  montant_brut          Decimal              @db.Decimal(15, 2)
  // Commission SoliFund, figée à la demande : taux en vigueur ce jour-là (en %), montant arrondi
  // à l'entier, et montant net à verser (brut - commission).
  taux_commission       Decimal              @db.Decimal(5, 2)
  montant_commission    Decimal              @db.Decimal(15, 2)
  montant_net           Decimal              @db.Decimal(15, 2)
  methode_retrait       MethodePaiement
  numero_beneficiaire   String               @db.VarChar(20)
  // Notre référence du versement en cours ou du dernier versement (« SOLIFUND-RET-<id> », puis
  // « -2 », « -3 » à chaque relance), le fournisseur qui l'a versé, et la référence du versement
  // chez lui (Notch Pay : « po.… » ; AangaraaPay : reference_id).
  reference_retrait     String?              @unique @db.VarChar(255)
  fournisseur           FournisseurPaiement?
  reference_fournisseur String?              @db.VarChar(255)
  tentatives_versement  Int                  @default(0)
  // Raison du dernier échec de versement.
  code_erreur           String?              @db.VarChar(100)
  message_erreur        String?
  // Mode manuel de secours : somme versée hors plateforme, sans appel à Notch Pay.
  hors_plateforme       Boolean              @default(false)
  // Administrateur qui a lancé le versement ou marqué le retrait comme versé.
  traite_par            Int?
  motif_rejet           String?
  statut                StatutRetrait        @default(EN_ATTENTE)
  date_creation         DateTime             @default(now())
  date_traitement       DateTime?
  date_validation       DateTime?

  id_utilisateur Int
  utilisateur    Utilisateur @relation(fields: [id_utilisateur], references: [id_utilisateur], onDelete: Restrict)

  id_cagnotte Int
  cagnotte    Cagnotte @relation(fields: [id_cagnotte], references: [id_cagnotte], onDelete: Restrict)

  transactions Transaction[]
  commission   Commission?

  @@index([id_utilisateur])
  @@index([id_cagnotte])
  @@index([reference_fournisseur])
  @@map("slf_retrait")
}

// Événements reçus de Notch Pay par webhook : l'identifiant unique évite de traiter deux fois le
// même événement. date_traitement reste vide tant que le traitement n'a pas abouti.
model WebhookRecu {
  id_webhook      Int       @id @default(autoincrement())
  id_evenement    String    @unique @db.VarChar(255)
  type            String    @db.VarChar(100)
  reference       String?   @db.VarChar(255)
  date_reception  DateTime  @default(now())
  date_traitement DateTime?

  @@map("slf_webhook_recu")
}

model Transaction {
  id_transaction Int               @id @default(autoincrement())
  type           TypeTransaction
  montant        Decimal           @db.Decimal(15, 2)
  devise         String            @default("XAF") @db.VarChar(10)
  reference      String?           @unique @db.VarChar(255)
  statut         StatutTransaction @default(EN_ATTENTE)
  date_creation  DateTime          @default(now())

  id_paiement Int?
  paiement    Paiement? @relation(fields: [id_paiement], references: [id_paiement], onDelete: Restrict)

  id_retrait Int?
  retrait    Retrait? @relation(fields: [id_retrait], references: [id_retrait], onDelete: Restrict)

  @@index([id_paiement])
  @@index([id_retrait])
  @@map("slf_transaction")
}

model Notification {
  id_notification Int              @id @default(autoincrement())
  // Code de la notification et ses paramètres : le frontend affiche le texte dans la langue
  // active. Les notifications créées avant ce changement n'ont pas de code : leur texte
  // (titre, message) est affiché tel quel.
  code            String?          @db.VarChar(100)
  parametres      Json?
  titre           String?          @db.VarChar(255)
  message         String?
  type            TypeNotification
  date_envoi      DateTime         @default(now())

  id_cagnotte Int?
  cagnotte    Cagnotte? @relation(fields: [id_cagnotte], references: [id_cagnotte], onDelete: Cascade)

  destinataires Recevoir[]

  @@index([type])
  @@index([id_cagnotte])
  @@map("slf_notification")
}

model Recevoir {
  statut       StatutLecture @default(NON_LUE)
  date_lecture DateTime?

  id_utilisateur Int
  utilisateur    Utilisateur @relation(fields: [id_utilisateur], references: [id_utilisateur], onDelete: Cascade)

  id_notification Int
  notification    Notification @relation(fields: [id_notification], references: [id_notification], onDelete: Cascade)

  @@id([id_utilisateur, id_notification])
  @@index([id_utilisateur])
  @@index([statut])
  @@map("slf_recevoir")
}

model Actualite {
  id_actualite     Int      @id @default(autoincrement())
  titre            String   @db.VarChar(255)
  contenu          String
  date_publication DateTime @default(now())

  id_cagnotte Int
  cagnotte    Cagnotte @relation(fields: [id_cagnotte], references: [id_cagnotte], onDelete: Cascade)

  @@index([id_cagnotte])
  @@map("slf_actualite")
}

enum TypePieceIdentite {
  CNI
  RECEPISSE_CNI
  PASSEPORT
}

enum StatutVerificationIdentite {
  EN_ATTENTE
  VALIDEE
  REFUSEE
}

enum ActionJournalIdentite {
  CONSULTATION_FICHIER
  VALIDATION
  REFUS
}

// Vérification d'identité d'un organisateur. Une ligne par soumission : l'historique est conservé,
// et la dernière soumission fait foi (identité vérifiée = dernière soumission VALIDEE).
model VerificationIdentite {
  id_verification Int               @id @default(autoincrement())
  type_piece      TypePieceIdentite
  // Tels qu'écrits sur la pièce.
  nom             String            @db.VarChar(100)
  prenoms         String            @db.VarChar(150)
  date_naissance  DateTime          @db.Date
  numero_piece    String            @db.VarChar(50)
  // Facultative pour le récépissé de CNI.
  date_expiration DateTime?         @db.Date

  // Noms des fichiers dans le stockage privé (jamais servis en statique). Le verso est facultatif
  // pour le passeport. Vidés quand les fichiers d'une soumission refusée sont supprimés (30 jours).
  fichier_recto         String?   @db.VarChar(255)
  fichier_verso         String?   @db.VarChar(255)
  fichier_selfie        String?   @db.VarChar(255)
  fichiers_supprimes_le DateTime?

  // Numéro Mobile Money (9 chiffres) et opérateur sur lesquels les retraits sont versés.
  telephone_retrait String          @db.VarChar(20)
  methode_retrait   MethodePaiement

  statut          StatutVerificationIdentite @default(EN_ATTENTE)
  motif_refus     String?
  date_soumission DateTime                   @default(now())
  date_decision   DateTime?

  id_utilisateur Int
  utilisateur    Utilisateur @relation("VerificationsUtilisateur", fields: [id_utilisateur], references: [id_utilisateur], onDelete: Restrict)

  // Administrateur ayant validé ou refusé.
  id_admin Int?
  admin    Utilisateur? @relation("DecisionsAdmin", fields: [id_admin], references: [id_utilisateur], onDelete: Restrict)

  journal JournalVerificationIdentite[]

  @@index([id_utilisateur])
  @@index([statut])
  @@map("slf_verification_identite")
}

// Journal des accès aux pièces d'identité et des décisions : qui, quoi, quand.
model JournalVerificationIdentite {
  id_journal Int                   @id @default(autoincrement())
  action     ActionJournalIdentite
  // Fichier consulté (recto, verso, selfie) ou motif du refus.
  detail     String?
  date       DateTime              @default(now())

  id_verification Int
  verification    VerificationIdentite @relation(fields: [id_verification], references: [id_verification], onDelete: Cascade)

  id_admin Int
  admin    Utilisateur @relation(fields: [id_admin], references: [id_utilisateur], onDelete: Restrict)

  @@index([id_verification])
  @@map("slf_journal_verification_identite")
}

enum MotifSignalement {
  ARNAQUE
  CONTENU_INAPPROPRIE
  FAUSSES_INFORMATIONS
  AUTRE
}

enum StatutSignalement {
  OUVERT
  CLASSE
}

// Signalement d'une cagnotte par un utilisateur connecté ou un visiteur. Un seul par compte (ou,
// pour un visiteur, par adresse IP) et par cagnotte.
model Signalement {
  id_signalement  Int               @id @default(autoincrement())
  motif           MotifSignalement
  commentaire     String?
  date            DateTime          @default(now())
  statut          StatutSignalement @default(OUVERT)
  date_classement DateTime?

  id_cagnotte Int
  cagnotte    Cagnotte @relation(fields: [id_cagnotte], references: [id_cagnotte], onDelete: Cascade)

  // Auteur s'il était connecté ; sinon empreinte (SHA-256 salé) de son adresse IP, jamais l'IP en clair.
  id_utilisateur Int?
  utilisateur    Utilisateur? @relation("SignalementsAuteur", fields: [id_utilisateur], references: [id_utilisateur], onDelete: SetNull)
  empreinte_ip   String?      @db.VarChar(64)

  // Administrateur ayant classé le signalement.
  id_admin Int?
  admin    Utilisateur? @relation("SignalementsAdmin", fields: [id_admin], references: [id_utilisateur], onDelete: SetNull)

  @@unique([id_cagnotte, id_utilisateur])
  @@unique([id_cagnotte, empreinte_ip])
  @@index([statut])
  @@map("slf_signalement")
}

// Registre des commissions : une ligne par retrait traité (versé) sur lequel une commission a
// été prélevée. Sert au suivi des revenus de SoliFund.
model Commission {
  id_commission Int      @id @default(autoincrement())
  montant       Decimal  @db.Decimal(15, 2)
  // Taux appliqué, en %.
  taux          Decimal  @db.Decimal(5, 2)
  date          DateTime @default(now())

  id_retrait Int     @unique
  retrait    Retrait @relation(fields: [id_retrait], references: [id_retrait], onDelete: Restrict)

  id_cagnotte Int
  cagnotte    Cagnotte @relation(fields: [id_cagnotte], references: [id_cagnotte], onDelete: Restrict)

  @@index([date])
  @@index([id_cagnotte])
  @@map("slf_commission")
}

// Alertes des administrateurs en attente d'email (regroupement : un email au plus toutes les
// 10 minutes, voir AlertesAdminService). Gardées en base pour survivre à un redémarrage ou à une
// mise en veille de l'application, et pour être envoyées par la tâche « alertes » (Cron).
model AlerteEmail {
  id_alerte     Int       @id @default(autoincrement())
  code          String    @db.VarChar(50)
  parametres    Json
  date_creation DateTime  @default(now())
  // Vide tant que l'alerte n'a pas été envoyée par email.
  date_envoi    DateTime?

  @@index([date_envoi])
  @@map("slf_alerte_email")
}
