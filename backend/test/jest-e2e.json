{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/tsconfig.json"
      }
    ]
  },
  "transformIgnorePatterns": ["/node_modules/(?!@nestjs/schedule/)"],
  "globalSetup": "<rootDir>/preparation-globale.ts",
  "setupFiles": ["<rootDir>/environnement.ts"],
  "maxWorkers": 1,
  "testTimeout": 30000,
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  }
}
