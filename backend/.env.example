# Copier ce fichier en .env et remplacer les valeurs factices.

# --- Obligatoires (l'application refuse de démarrer sans elles) ---
# Connexion PostgreSQL
DATABASE_URL="postgresql://utilisateur:motdepasse@localhost:5432/solifund?schema=public"
# Secret de signature des tokens JWT : au moins 32 caractères aléatoires
# (ex. : node -e "console.log(require('crypto').randomBytes(48).toString('base64'))")
JWT_SECRET="remplacer-par-une-longue-chaine-aleatoire-de-32-caracteres-minimum"
# Envoi des emails (codes de réinitialisation) via Brevo
BREVO_API_KEY="xkeysib-valeur-factice"
BREVO_SENDER_EMAIL="no-reply@exemple.cm"
# URL du frontend autorisée par CORS (sans / final)
FRONTEND_URL="http://localhost:5173"

# --- Facultatives ---
# Nom de l'expéditeur des emails
BREVO_SENDER_NOM="Solifund"
# URL publique du backend (sans / final), utilisée dans les liens de partage des cagnottes et
# les aperçus WhatsApp / Facebook (photo en URL absolue). Par défaut : http://localhost:<PORT>.
#   Production : PUBLIC_API_URL="https://api.solifund.cm"
#   Développement via le proxy Vite ou un tunnel : PUBLIC_API_URL="https://<adresse-du-tunnel>/api"
PUBLIC_API_URL="http://localhost:3000"
# Commission SoliFund prélevée sur chaque retrait, en % du montant demandé. Le taux est figé dans
# chaque retrait au moment de la demande : le changer ne modifie pas les retraits déjà demandés.
COMMISSION_TAUX_POURCENT=3
# Montant minimum d'un don, en XAF (100 par défaut). Le formulaire de don le lit par
# GET /configuration. Les limites des retraits ne changent pas.
DON_MONTANT_MINIMUM=100
# Frais de transaction Mobile Money, payés par le donateur EN PLUS de son don, en % (deux
# décimales au plus). Frais = don × (encaissement de l'opérateur du donateur + versement de
# l'opérateur de retrait vérifié de l'organisateur ; le versement le plus élevé s'il n'est pas
# encore connu), arrondis au franc supérieur. Seul le don est ajouté à la cagnotte.
# Valeurs par défaut : tarifs d'AangaraaPay. Mettre 0 partout pour ne facturer aucun frais.
FRAIS_MTN_ENCAISSEMENT_POURCENT=1.7
FRAIS_MTN_VERSEMENT_POURCENT=1.3
FRAIS_ORANGE_ENCAISSEMENT_POURCENT=1.5
FRAIS_ORANGE_VERSEMENT_POURCENT=2.1

# Modération des cagnottes.
# Objectif (XAF) au-dessus duquel une cagnotte est vérifiée par un administrateur avant publication.
SEUIL_OBJECTIF_VERIFICATION=1000000
# Nombre de signalements ouverts à partir duquel une cagnotte active est suspendue automatiquement.
SEUIL_SIGNALEMENTS=3
# Dossier du stockage privé (pièces d'identité des organisateurs), jamais servi publiquement.
# Par défaut : backend/stockage-prive. En production, utiliser un volume persistant et sauvegardé.
# STOCKAGE_PRIVE_DIR="/var/lib/solifund/stockage-prive"
# Dossier des photos des cagnottes, servies publiquement sous /uploads. Par défaut : backend/uploads.
# En production, utiliser un volume persistant : sans lui, les photos sont perdues à chaque déploiement.
# UPLOADS_DIR="/var/lib/solifund/uploads"
# Port HTTP (3000 par défaut)
PORT=3000
# development | production | test — en production, la documentation /docs est désactivée
NODE_ENV=development

# Base des tests e2e (npm run test:e2e). Par défaut : la base de DATABASE_URL suffixée par « _test »,
# créée automatiquement. Son nom doit contenir « test » : les tests vident toutes ses tables.
# DATABASE_URL_TEST="postgresql://utilisateur:motdepasse@localhost:5432/solifund_test?schema=public"

# --- Connexion avec Google (facultative : les trois variables ensemble, ou aucune) ---
# Identifiants OAuth créés dans la Google Cloud Console (API et services > Identifiants >
# ID client OAuth, type « Application Web »). L'URL de retour doit être déclarée à l'identique
# dans « URI de redirection autorisés ». En développement, elle passe par le proxy Vite (/api).
GOOGLE_CLIENT_ID="000000000000-exemple.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="valeur-factice"
GOOGLE_CALLBACK_URL="http://localhost:5173/api/auth/google/callback"

# --- Paiement Mobile Money (module backend/src/payment/) ---
# Fournisseur des nouveaux paiements et versements : notchpay (par défaut) ou aangaraa. Les clés du
# fournisseur actif sont obligatoires. Un paiement déjà lancé est toujours suivi chez le fournisseur
# qui l'a traité : garder ses clés tant que des paiements ou versements sont en cours chez lui.
PAIEMENT_FOURNISSEUR=notchpay

# --- AangaraaPay (obligatoire si PAIEMENT_FOURNISSEUR=aangaraa) ---
# Clé du service (app_key), dans le tableau de bord AangaraaPay. Elle est envoyée dans le corps
# des requêtes (et dans l'adresse pour le solde) ; elle n'est jamais écrite dans les logs.
AANGARAA_APP_KEY="valeur-factice"
# URL de l'API (facultative).
AANGARAA_API_URL="https://api-production.aangaraa-pay.com"
# AangaraaPay ne signe pas ses notifications : l'adresse du webhook contient ce jeton secret
# (au moins 32 caractères aléatoires, ex. : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
# Une notification sans ce jeton est refusée (403). Le jeton n'est jamais écrit dans les logs.
AANGARAA_WEBHOOK_JETON="remplacer-par-une-longue-valeur-aleatoire-de-32-caracteres-minimum"
# Le webhook (notify_url) est construit avec PUBLIC_API_URL :
#   <PUBLIC_API_URL>/paiements/webhook/aangaraa/<AANGARAA_WEBHOOK_JETON>
# PUBLIC_API_URL est donc obligatoire avec AangaraaPay, et doit être joignable depuis Internet.

# --- Notch Pay (obligatoire si PAIEMENT_FOURNISSEUR=notchpay) ---
# Clés du compte Notch Pay (https://business.notchpay.co > Settings > API Keys).
# En développement, utiliser les clés du mode test (« Sandbox ») : elles contiennent « test ».
# Hors production (NODE_ENV différent de « production »), l'application REFUSE DE DÉMARRER avec une
# clé « live », qui déplace de l'argent réel. Pour l'autoriser quand même, décommenter :
# NOTCHPAY_AUTORISER_LIVE_EN_DEV=true
# En production, un avertissement est écrit au démarrage si une clé de test est utilisée.
# Clé publique : envoyée sur toutes les requêtes.
NOTCHPAY_PUBLIC_KEY="pk_test_valeur-factice"
# Clé privée : envoyée uniquement pour les versements et la lecture du solde. Ne jamais la publier.
NOTCHPAY_PRIVATE_KEY="sk_test_valeur-factice"
# Hash de signature des webhooks (en-tête x-notch-signature). Obligatoire en production,
# facultatif sinon ; sans lui, tous les webhooks sont refusés (403).
# URL à déclarer chez Notch Pay (Settings > Webhooks) : <URL publique du backend>/paiements/webhook/notchpay
NOTCHPAY_WEBHOOK_HASH="hsk_test_valeur-factice"
# Format des numéros envoyés à Notch Pay (customer.phone, data.phone, beneficiary_data.phone) :
#   sans_plus → 237677123456 (défaut, comme les exemples de docs/paiement/notchpay-openapi.yaml)
#   avec_plus → +237677123456 (comme les exemples des guides de Notch Pay)
NOTCHPAY_FORMAT_TELEPHONE=sans_plus
# URL de l'API (facultative ; la même pour le mode test et la production).
NOTCHPAY_API_URL="https://api.notchpay.co"
