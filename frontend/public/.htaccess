# SoliFund : site statique (build Vite) servi par Apache (o2switch). Copié tel quel dans dist/.

Options -Indexes
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Toujours en HTTPS (le certificat AutoSSL de cPanel couvre le sous-domaine).
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Application React (react-router) : toute adresse qui n'est ni un fichier ni un dossier existant
  # (/cagnottes/12, /login, /admin/retraits...) est servie par index.html.
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Fichiers produits par Vite (assets/<nom>-<empreinte>.js|css...) : leur nom change à chaque build,
  # ils peuvent être gardés un an sans jamais être périmés.
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # index.html (et donc toutes les routes de l'application) : toujours revalidé, pour charger la
  # dernière version du site après une mise à jour.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Images et icônes de public/ (noms fixes) : une semaine.
  <FilesMatch "\.(webp|png|jpe?g|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
